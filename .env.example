# Local development defaults
POSTGRES_DB=cloudsentinel
POSTGRES_USER=cloudsentinel
POSTGRES_PASSWORD=change_me_to_a_strong_password

DATABASE_URL=postgresql+psycopg://cloudsentinel:change_me@localhost:15432/cloudsentinel
REDIS_URL=redis://localhost:16379/0

SCAN_QUEUE_STREAM=cloudsentinel:scan_jobs
SCAN_QUEUE_GROUP=cloudsentinel:scan_workers
SCAN_QUEUE_MAX_RETRIES=3
SCAN_QUEUE_RECOVERY_IDLE_MS=30000
SCAN_QUEUE_RECOVERY_BATCH_SIZE=10
SCAN_QUEUE_READ_BLOCK_MS=5000
SCAN_QUEUE_DEAD_LETTER_MAX_LENGTH=10000
SCAN_QUEUE_WORKER_HEARTBEAT_SECONDS=10
SCAN_QUEUE_WORKER_STALE_SECONDS=30
MAX_CONCURRENT_SCANS_PER_TENANT=2
SCAN_SCHEDULER_POLL_SECONDS=10

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_generated_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ALLOWED_ORIGINS=http://localhost:8000

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_SCAN_MAX_REQUESTS=20
RATE_LIMIT_GLOBAL_MAX_REQUESTS=300

AWS_STS_SESSION_DURATION_SECONDS=900
AWS_SDK_CONNECT_TIMEOUT_SECONDS=10
AWS_SDK_READ_TIMEOUT_SECONDS=60

APP_ENVIRONMENT=development
AUDIT_RETENTION_DAYS=365
MAX_REQUEST_BODY_BYTES=1048576
TRUSTED_PROXY_IPS=

SECURITY_HEADERS_HSTS_ENABLED=false
SECURITY_HEADERS_HSTS_MAX_AGE_SECONDS=31536000

METRICS_ENABLED=false
METRICS_AUTH_TOKEN=
METRICS_QUEUE_REFRESH_SECONDS=30

LOG_LEVEL=INFO
LOG_FORMAT=auto

# PostgreSQL backup operations
BACKUP_OUTPUT_DIR=./backups/postgres
BACKUP_LOCAL_RETENTION_DAYS=14

# Optional off-host replication. Never commit production values here.
# BACKUP_S3_BUCKET=cloudsentinel-production-backups
# BACKUP_S3_PREFIX=cloudsentinel/postgres
# BACKUP_S3_KMS_KEY_ID=
