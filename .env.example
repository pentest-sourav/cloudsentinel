DATABASE_URL=postgresql+psycopg://cloudsentinel:change_me@localhost:15432/cloudsentinel
REDIS_URL=redis://localhost:16379/0
SCAN_QUEUE_STREAM=cloudsentinel:scan_jobs
SCAN_QUEUE_GROUP=cloudsentinel:scan_workers
JWT_SECRET_KEY=generate_a_secure_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_SCAN_MAX_REQUESTS=20
RATE_LIMIT_GLOBAL_MAX_REQUESTS=300

APP_ENVIRONMENT=development
AUDIT_RETENTION_DAYS=365
MAX_REQUEST_BODY_BYTES=1048576
TRUSTED_PROXY_IPS=
METRICS_ENABLED=false
METRICS_AUTH_TOKEN=


# PostgreSQL backup operations
# Run the backup utility from a trusted scheduler/backup runtime.
BACKUP_OUTPUT_DIR=./backups/postgres
BACKUP_LOCAL_RETENTION_DAYS=14
# Optional off-host replication:
# BACKUP_S3_BUCKET=cloudsentinel-production-backups
# BACKUP_S3_PREFIX=cloudsentinel/postgres
# BACKUP_S3_KMS_KEY_ID=
