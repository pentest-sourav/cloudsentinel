[Unit]
Description=CloudSentinel PostgreSQL backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=cloudsentinel
Group=cloudsentinel
WorkingDirectory=/opt/cloudsentinel
EnvironmentFile=/etc/cloudsentinel/backup.env
ExecStart=/opt/cloudsentinel/.venv/bin/python ops/backup/postgres_backup.py backup
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cloudsentinel/backups
