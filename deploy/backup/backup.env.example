# Production PostgreSQL backup configuration.
# Store the real file outside Git with chmod 600.

DATABASE_URL=postgresql+psycopg://cloudsentinel:<PASSWORD>@127.0.0.1:5432/cloudsentinel
BACKUP_OUTPUT_DIR=/var/lib/cloudsentinel/backups
BACKUP_LOCAL_RETENTION_DAYS=14

# Pin the PostgreSQL client major to the production server.
# For PostgreSQL 17 on a standard Linux host:
PG_DUMP_BIN=/usr/lib/postgresql/17/bin/pg_dump
PG_RESTORE_BIN=/usr/lib/postgresql/17/bin/pg_restore
BACKUP_EXPECTED_POSTGRES_MAJOR=17

# Recommended: off-host encrypted copy.
# BACKUP_S3_BUCKET=your-production-backup-bucket
# BACKUP_S3_PREFIX=cloudsentinel/postgres
# BACKUP_S3_KMS_KEY_ID=arn:aws:kms:...
